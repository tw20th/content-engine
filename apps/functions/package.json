{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.js --sourcemap --external:firebase-admin --external:firebase-functions --external:cron-parser --external:@tw20th/content-engine --external:@tw20th/strategy-quiet-spread --external:@tw20th/strategy-quiet-rewrite --external:@tw20th/strategy-rewrite-basic --external:@tw20th/strategy-seo-basic --external:@tw20th/strategy-openai-basic",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "serve": "firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "@tw20th/content-engine": "workspace:*",
    "@tw20th/strategy-openai-basic": "workspace:*",
    "@tw20th/strategy-quiet-rewrite": "workspace:*",
    "@tw20th/strategy-quiet-spread": "workspace:*",
    "@tw20th/strategy-rewrite-basic": "workspace:*",
    "@tw20th/strategy-seo-basic": "workspace:*",
    "cron-parser": "^4.9.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.0"
  }
}
