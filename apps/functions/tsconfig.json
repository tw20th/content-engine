{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "lib": ["ES2020"],
    "outDir": "lib",
    "rootDir": "src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"],
    "baseUrl": ".",

    "resolvePackageJsonExports": true,
    "resolvePackageJsonImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/types/content-engine.d.ts.bak"]
}
