{
  "name": "subscope",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "pnpm -r build",
    "build:pkgs": "pnpm -r --filter \"@tw20th/*\" build",
    "build:engine": "pnpm -r --filter \"@tw20th/content-engine...\" build",
    "lint": "turbo lint",
    "format": "prettier -w ."
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.3",
    "tailwindcss": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "@tw20th/content-engine": "workspace:*",
    "@tw20th/strategy-openai-basic": "workspace:*",
    "@tw20th/strategy-quiet-rewrite": "workspace:*",
    "@tw20th/strategy-quiet-spread": "workspace:*",
    "@tw20th/strategy-rewrite-basic": "workspace:*",
    "@tw20th/strategy-seo-basic": "workspace:*"
  }
}
