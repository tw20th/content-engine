{
  "name": "@tw20th/strategy-quiet-rewrite",
  "version": "0.0.19",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tw20th/content-engine": "^0.0.19"
  },
  "devDependencies": {
    "@tw20th/content-engine": "workspace:*",
    "typescript": "^5.9.3"
  }
}
